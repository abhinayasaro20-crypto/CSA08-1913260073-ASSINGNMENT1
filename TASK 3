# Task 3: Constants, Dynamic Typing, and Swapping
BASE_RATE = 30.00
BASE_FAT = 3.5
BASE_SNF = 8.5
FAT_ADJUSTMENT = 0.40
SNF_ADJUSTMENT = 0.30

# Demonstrate dynamic typing
sample_variable = 250
print("Type:", type(sample_variable), "Value:", sample_variable)
sample_variable = "Active Status"
print("Type:", type(sample_variable), "Value:", sample_variable)

# Multiple assignment and swapping
x = 10
y = 20
print(f"Before swap: x = {x}, y = {y}")
x, y = y, x
print(f"After swap: x = {x}, y = {y}")
